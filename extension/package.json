{
  "name": "brinspector-extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "babel-jest": "^30.0.0",
    "jest": "^30.0.0",
    "vite": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/unit/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/lib/**/*.js"
    ]
  }
}
