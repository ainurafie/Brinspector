{
  "name": "brinspector-backend",
  "version": "0.2.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "dotenv": "^17.0.0",
    "fastify": "^5.4.0"
  },
  "devDependencies": {
    "jest": "^30.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["<rootDir>/tests/**/*.test.js"],
    "collectCoverageFrom": ["src/**/*.js", "!src/server.js"]
  }
}
