# Copy to backend/.env — NEVER commit the real .env
PORT=3000

# mock   → rule-based summary, no network, no cost (default for dev & tests)
# azure  → Azure OpenAI / Microsoft Foundry deployment (header: api-key)
# openai → any OpenAI-compatible endpoint (header: Authorization: Bearer)
AI_PROVIDER=mock

# Azure / Foundry example: https://<your-resource>.openai.azure.com/openai/v1
# (copy the endpoint + key from your Foundry deployment page)
AI_BASE_URL=
AI_API_KEY=
# Deployment/model name. A small, cheap model is enough for summaries (e.g. a "mini" model).
AI_MODEL=

AI_TIMEOUT_MS=20000
