#!/bin/sh
# Pre-push guard: blocks the push when any unit test fails.
# Activated automatically by `npm install` (root "prepare" script sets core.hooksPath=.githooks).
set -eu

echo "[pre-push] Running unit tests..."
if ! npm test --silent; then
  echo "[pre-push] Tests failed. Push cancelled. Fix the tests and try again."
  exit 1
fi
echo "[pre-push] All tests passed."
